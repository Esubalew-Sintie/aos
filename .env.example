# Copy to .env and fill in. Never commit .env.

# Postgres connection string.
AOS_DATABASE_URL=postgres://user:password@localhost:5432/aos?sslmode=disable

# Wraps every tenant's keys. Make one with: bin/aos keygen
# Keep it safe and backed up. Losing it makes every tenant's secrets unreadable.
AOS_MASTER_KEY=

# production (the default) or development.
# In development, emails are written to the log instead of being sent.
AOS_ENV=development

AOS_LISTEN_ADDR=:8080

# Networks whose X-Forwarded-For header is believed. Empty means none.
AOS_TRUSTED_PROXIES=

# How email is sent. Required in production.
AOS_SMTP_ADDR=
AOS_SMTP_USERNAME=
AOS_SMTP_PASSWORD=
AOS_MAIL_FROM=
